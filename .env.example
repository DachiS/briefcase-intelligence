# Database
DATABASE_URL="postgresql://username:password@localhost:5432/spy_magazine"

# JWT Secret (generate a random 32+ character string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# NextAuth (Google OAuth login)
NEXTAUTH_SECRET="another-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Paddle (Merchant of Record) — get these from https://vendors.paddle.com
# Server-side: API key + webhook signing secret.
PADDLE_API_KEY="apikey_..."
PADDLE_WEBHOOK_SECRET="pdl_ntfset_..."
# Client-side: the public client-side token. REQUIRED for the checkout overlay
# to load — without it the /subscribe buttons never open Paddle.js.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="live_..."
# Set to "sandbox" to use Paddle's sandbox; leave unset/empty for production.
NEXT_PUBLIC_PADDLE_ENV=""
# NOTE: Paddle price IDs (pri_…) live in src/lib/pricing.ts, the single source
# of truth — they are NOT read from env. No price-id env vars are needed.

# AWS S3 (for PDF and image storage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="spy-magazine-pdfs"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Site access gate (optional, defaults to "briefcase")
SITE_ACCESS_CODE="briefcase"

# Email (nodemailer - use Gmail or SMTP)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="Spy Magazine <your@gmail.com>"
